{
  "name": "gohany/rtry",
  "description": "Retries with jittered backoff, Retry-After, deadlines, retry budgets and circuit breakers: an implementation of gohany/retry",
  "keywords": ["rtry", "retry", "backoff", "jitter", "circuit breaker", "retry budget"],
  "homepage": "https://github.com/Gohany/Rtry",
  "license": "MIT",
  "authors": [
    {
      "name": "Greg Riley",
      "homepage": "https://github.com/Gohany"
    }
  ],
  "require": {
    "php": "^8.2",
    "gohany/retry": "^2.0",
    "psr/clock": "^1.0",
    "psr/http-message": "^1.0 || ^2.0",
    "psr/log": "^1 || ^2 || ^3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Gohany\\Rtry\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gohany\\Rtry\\Tests\\": "tests"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
